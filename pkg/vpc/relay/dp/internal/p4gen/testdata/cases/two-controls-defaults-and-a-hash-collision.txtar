name: two controls, defaults and a hash collision
# The hashes of c2002 and c3002 are the same in the low 24 bits; the first name in sorted
# order gets it.
ids: NoAction=21257015 SmallEgress.t=37562719 SmallIngress.c2002=0x02b3e7ee
ids: SmallIngress.c3002=0x02b3e7ef SmallIngress.t=33722580
-- prog.p4 --
// SPDX-License-Identifier: AGPL-3.0-only

// A small program for the p4gen test. p4info.txtpb is the output of
// `p4test --arch v1model --p4runtime-files p4info.txtpb prog.p4` (p4c 1.2.5.18).

#include <core.p4>
#include <v1model.p4>

const bit<8> R_ONE = 1;
const bit<32> SIZE = 1 << 10;

@p4runtime_translation("apoxy.dev/test/name", string)
type bit<32> name_t;

@controller_header("packet_in")
header to_cp_t {
    bit<8> kind;
    bit<16> port;
}
@controller_header("packet_out")
header from_cp_t {
    bit<8> kind;
}
header eth_t {
    bit<48> dst;
}
struct headers_t {
    to_cp_t to_cp;
    from_cp_t from_cp;
    eth_t eth;
}
struct inner_t {
    bit<64> session;
}
struct meta_t {
    bit<64> port;
    name_t vpc;
    bool flag;
    bit<128> dst;
    inner_t p;
}

extern PspSa {
    PspSa(bit<32> size);
    void count(in bit<32> spi);
}

parser SmallParser(packet_in pkt, out headers_t h, inout meta_t m, inout standard_metadata_t sm) {
    state start {
        pkt.extract(h.eth);
        transition accept;
    }
}

control SmallIngress(inout headers_t h, inout meta_t m, inout standard_metadata_t sm) {
    counter(SIZE, CounterType.packets_and_bytes) cells;
    counter(32, CounterType.packets) drops;
    meter(1 << 4, MeterType.bytes) rate;
    PspSa(16) keys;
    @hidden action step() {
    }
    action unused(bit<8> x) {
        m.port = (bit<64>)x;
    }
    // p4c inlines helper, which only an action calls, and removes it.
    action helper() {
        m.flag = false;
    }
    action drop(bit<8> reason) {
        helper();
        drops.count((bit<32>)reason);
        mark_to_drop(sm);
        exit;
    }
    action set(name_t vpc, bit<64> session, bool flag) {
        m.vpc = vpc;
        m.p.session = session;
        m.flag = flag;
    }
    action pin(bit<64> session, bool flag) {
        m.p.session = session;
        m.flag = flag;
    }
    // Only apply calls note, so p4c removes its parameter.
    action note(bit<64> x) {
        m.port = x;
    }
    action mark() {
        m.flag = true;
    }
    table t {
        key = {
            m.port: exact;
            m.vpc: exact;
            m.flag: exact;
            m.dst: lpm;
        }
        actions = { set; drop; }
    }
    table c3002 {
        key = { m.p.session: exact; }
        actions = { pin; NoAction; }
        const default_action = pin((bit<64>)((128w1 << 64) >> 64) + (bit<64>)(8w255 + 8w3), true); // 1 + 2: 8w255 + 8w3 wraps.
        size = 4096;
    }
    table c2002 {
        key = { h.eth.dst: exact; }
        actions = { NoAction; drop; }
        default_action = drop(R_ONE);
    }
    table spare {
        key = { m.port: exact; }
        actions = { drop; }
    }
    apply {
        step();
        t.apply();
        c3002.apply();
        c2002.apply();
        mark();
        note(5);
    }
}

control SmallEgress(inout headers_t h, inout meta_t m, inout standard_metadata_t sm) {
    counter(8, CounterType.bytes) drops;
    meter(4, MeterType.packets) rate;
    action set(bit<16> port) {
        h.to_cp.port = port;
    }
    table t {
        key = { m.port: exact; }
        actions = { set; NoAction; }
        size = SIZE;
    }
    apply {
        if (h.from_cp.isValid()) {
            t.apply();
        }
    }
}

control SmallVerify(inout headers_t h, inout meta_t m) {
    apply {
    }
}

control SmallCompute(inout headers_t h, inout meta_t m) {
    apply {
    }
}

control SmallDeparser(packet_out pkt, in headers_t h) {
    apply {
        pkt.emit(h.to_cp);
        pkt.emit(h.eth);
    }
}

V1Switch(SmallParser(), SmallVerify(), SmallIngress(), SmallEgress(), SmallCompute(), SmallDeparser()) main;
-- p4info.txtpb --
